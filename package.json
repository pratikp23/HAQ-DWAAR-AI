{
  "name": "haqdwaar-ai",
  "version": "1.0.0",
  "description": "Scheme se Application Tak - A Citizen Benefit Readiness & Navigation Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "seed:schemes": "npm --prefix server run seed:schemes"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "haqdwaar",
    "citizen-benefits",
    "government-schemes",
    "navigation"
  ],
  "author": "HaqDwaar Team",
  "license": "MIT",
  "type": "module"
}
