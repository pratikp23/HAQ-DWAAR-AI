# ==============================================================================
# HAQ DWAAR AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in your local or production credentials.
# NOTE: Never commit '.env' to version control. Keep all credentials private.

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection URI (Local replica set or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/haqdwaar-ai

# JWT Signing Secret (Generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Backend-only; used for Life Situation NLU and Notification text extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Bhashini Speech-to-Text Configuration
# When API keys are blank, system automatically defaults to mock/demo mode
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# DigiLocker Gateway Configuration ('demo' uses synthetic simulated documents)
DIGILOCKER_MODE=demo
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback

# WhatsApp Dispatch Service ('demo' logs notifications internally without dispatching external SMS/API)
WHATSAPP_MODE=demo
WHATSAPP_API_KEY=your_whatsapp_api_key_or_sandbox_token

# OCR Document Inspection Mode ('demo' uses lightweight deterministic heuristic checks)
OCR_MODE=demo
