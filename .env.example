# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/haqdwaar-ai

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# AI & Speech Services
GEMINI_API_KEY=your_gemini_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# Integration Modes: 'demo' or 'real'
DIGILOCKER_MODE=demo
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/digilocker/callback

WHATSAPP_MODE=demo
WHATSAPP_API_KEY=your_whatsapp_api_key

OCR_MODE=demo

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
